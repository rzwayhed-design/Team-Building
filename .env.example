# All optional.
PORT=3001
# Where events are saved so they survive restarts. Point at a persistent disk when hosted.
DATA_FILE=./server/data/events.json
# Only if the web app is hosted on a DIFFERENT domain than the server (comma-separated).
ALLOWED_ORIGINS=
# Client build only: backend URL when the web app is hosted separately.
VITE_SERVER_URL=
# AIM Academy Challenge: key that unlocks the AIM Question Bank page (/?aim-bank). Leave empty to disable editing.
AIM_ADMIN_KEY=
